{
  "manifest_version": 3,
  "name": "AI Relay",
  "version": "0.4.5",
  "description": "Human-moderated local relay between ChatGPT and Claude browser tabs. No API keys.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open AI Relay",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["adapters/chatgpt.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["adapters/claude.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
